{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "suzuri",
  "mainBinaryName": "suzuri",
  "version": "0.10.0",
  "identifier": "com.stephenshorton.suzuri",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "suzuri",
        "width": 1200,
        "height": 800,
        "minWidth": 400,
        "minHeight": 240,
        "visible": false,
        "backgroundColor": "#0c0c10",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost ws://127.0.0.1:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "macOS": {
      "minimumSystemVersion": "12.0",
      "hardenedRuntime": true,
      "entitlements": "../packaging/macos/entitlements.plist",
      "infoPlist": "../packaging/macos/Info.plist"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "../packaging/windows/installer-hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEExRjkzMEUwNkMwMjFCRjQKUldUMEd3SnM0REQ1b2RzckE4RGRadXJyRFB3LzBCVVNic1JEc1RFSmRiZHJTUnNNT3lEQ2RPdWwK",
      "endpoints": [
        "https://github.com/StephenSHorton/suzuri/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
