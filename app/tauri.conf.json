{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "rust-suzuri",
  "mainBinaryName": "rust-suzuri",
  "version": "0.1.0",
  "identifier": "com.stephenshorton.rust-suzuri",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "suzuri",
        "width": 1200,
        "height": 800,
        "minWidth": 400,
        "minHeight": 240,
        "backgroundColor": "#0c0c10",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost ws://127.0.0.1:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
