{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "suzuri-surface",
  "version": "0.1.0",
  "identifier": "app.suzuri.surface",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "suzuri",
        "width": 1120,
        "height": 740,
        "minWidth": 720,
        "minHeight": 440,
        "resizable": true,
        "center": true,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "fullscreen": false,
        "focus": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
